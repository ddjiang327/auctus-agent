# Auctus Agent configuration

# Model route: local / byo / proxy
LLM_ROUTE=local

# Default model. DeepSeek is a low-cost default; change as needed.
MODEL=deepseek/deepseek-chat
EMBEDDING_MODEL=text-embedding-3-small

# Provider API keys. Fill at least one key for the model you use.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=

# Optional proxy / relay settings
PROXY_BASE_URL=
PROXY_API_KEY=
RELAY_SHARED_TOKEN=
RELAY_DESKTOP_ID=local-desktop
RELAY_URL=ws://127.0.0.1:8000/relay/tunnel/local-desktop

# Mobile relay — connect this desktop agent to the Alibaba Cloud relay server.
# Example: MOBILE_RELAY_URL=ws://120.24.223.0
# MOBILE_RELAY_ADMIN_SECRET is the relay server admin secret from deploy.sh.
# MOBILE_RELAY_DEVICE_TOKEN is auto-generated on first run when relay is configured.
MOBILE_RELAY_URL=
MOBILE_RELAY_ADMIN_SECRET=
MOBILE_RELAY_DEVICE_TOKEN=

# Optional Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Local paths
DATA_DIR=./data
OUTPUT_DIR=./outputs
WORKSPACE_DIR=./inputs
LOGS_DIR=./logs

# Agent behavior
MAX_TOOL_ITERATIONS=8
CONTEXT_TOKEN_BUDGET=8000
UPDATE_CHECK_URL=
AGENT_DOWNLOAD_URL=https://github.com/ddjiang327/auctus-agent/releases/latest
